NODE_ENV=development
PORT=3000
LOG_LEVEL=log

# --- OpenAI Agents API ---------------------------------------------------
# API key needs these project permissions:
#   api.agents.read, api.agents.write, api.responses.write
OPENAI_API_KEY=
# Saved Agent created in the OpenAI Platform UI (model / instructions / tools live there)
OPENAI_AGENT_ID=
# Optional: enables the "быстрая модель" / "умная модель" voice commands.
# Leave empty to disable model switching entirely.
OPENAI_MODEL_FAST=
OPENAI_MODEL_SMART=
# Hard timeout for a single OpenAI HTTP call (ms). Not the Alice budget.
OPENAI_REQUEST_TIMEOUT_MS=30000
# Local verification without a real key: uses an in-memory fake Agents provider.
OPENAI_FAKE=false

# --- Yandex Dialogs ------------------------------------------------------
# Webhook path secret: POST /api/alice/<ALICE_WEBHOOK_SECRET>
ALICE_WEBHOOK_SECRET=
# Optional: when set, requests whose session.skill_id differs are rejected.
ALICE_SKILL_ID=
# Yandex Dialogs waits 4.5s in total, so leave headroom for network + TTS.
ALICE_LLM_SOFT_TIMEOUT_MS=3200
# Alice caps response.text / response.tts at 1024 characters.
MAX_VOICE_RESPONSE_CHARS=900

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=alice
POSTGRES_PASSWORD=alice
POSTGRES_DB=alice

# --- Redis ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# How long the "a turn is running" marker survives in Redis (seconds).
PENDING_STATE_TTL_SECONDS=600

# --- Admin ---------------------------------------------------------------
# GET /api/admin/usage with "Authorization: Bearer <ADMIN_API_KEY>".
# Leave empty to disable the admin endpoint.
ADMIN_API_KEY=
